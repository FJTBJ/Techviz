# 依赖
node_modules/

# 构建缓存
*.tsbuildinfo

# 运行时数据（部署时保留服务器自己的库）
server/data/techviz.db
server/data/techviz.db-shm
server/data/techviz.db-wal
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# take 视频（体积大，部署时单独上传，不进仓库）
server/data/takes/

# 环境变量
.env
.env.*
!.env.example

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# UE 原始导出备份（体积大，仅本地保留；优化后的产物在 server/public/models）
.models-raw/

# 临时验证截图、镜头卡产物
tmp_probe/
shot/

# 本地产品文档（仅本地留存，不进仓库）
/Techviz-*.md
